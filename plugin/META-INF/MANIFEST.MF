Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: cooperativeArchi
Bundle-SymbolicName: io.github.p3chys.cooperativearchi;singleton:=true
Bundle-Version: ${version}
Bundle-Vendor: cooperativeArchi
Bundle-Activator: io.github.p3chys.cooperativearchi.ui.Activator
Bundle-ActivationPolicy: lazy
Bundle-RequiredExecutionEnvironment: JavaSE-${javaRelease}
Automatic-Module-Name: io.github.p3chys.cooperativearchi
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.ui,
 org.eclipse.jface,
 org.eclipse.jface.notifications,
 org.eclipse.equinox.security,
 org.eclipse.emf.ecore,
 org.eclipse.jgit;bundle-version="${jgitRange}",
 com.archimatetool.model,
 com.archimatetool.editor
Import-Package: javax.xml,
 javax.xml.parsers,
 org.w3c.dom,
 org.xml.sax
